# NagrikSetu Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key (Only needed for backend scrapers & admin tasks, do NOT expose in client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Layer-2 backend base URL for the chatbot (query decomposition) proxy routes
# (/api/v1/chatbot/*). Server-side only; defaults to http://localhost:8000.
NAGRIKSETU_API_URL=http://localhost:8000

# Sarvam voice (server-side only, never NEXT_PUBLIC_). Used by /api/v1/voice/*.
SARVAM_API_KEY=your-sarvam-key-here
# Optional overrides
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# --- Audit service (port 8787) ---
# Server-side only. The Next proxy /api/v1/audit/extract forwards to this service.
AUDIT_SERVICE_URL=http://localhost:8787
AUDIT_SERVICE_TOKEN=change-me-shared-secret

# --- Reviews & documents ---
# New reviews are published immediately (demo default). Set false to require moderation.
REVIEWS_AUTO_PUBLISH=true
# Zero-PII default: uploaded files are processed in RAM only. true stores them in Supabase Storage bucket "documents".
DOCUMENT_STORAGE_ENABLED=false

# --- Public feature flags ---
# Demo sign-in, for a deployment with no Supabase: true accepts any email with any 6+ digit code.
# Compose defaults it to true; a real deployment leaves it false and configures Supabase instead.
NEXT_PUBLIC_DEMO_AUTH=false
# true re-enables the FAKE local audit (invented IFSC/account results). Demo only.
NEXT_PUBLIC_DEMO_AUDIT=false
# Footer "Contact Grievance Redressal" link is hidden when unset. Use a real, monitored address.
NEXT_PUBLIC_SUPPORT_EMAIL=
