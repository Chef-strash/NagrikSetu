# Audit env (copy to .env; never commit real values — secrets via env only).
# The audit needs no Anthropic key: models run on ClinePass (R2).

# Auth: AUDIT_API_KEY, else CLINE_API_KEY, else the Cline OAuth token in
# ~/.cline/data/settings/providers.json (KTD2).
AUDIT_API_KEY=

# Shared secret for POST /extract, sent as the `x-audit-token` header.
# With this unset the endpoint refuses to run at all (fail closed, 503).
AUDIT_SERVICE_TOKEN=

# Optional model overrides (defaults shown).
AUDIT_PROVIDER_ID=cline-pass
AUDIT_MODEL_ID=cline-pass/glm-5.3
# The only vision-capable ClinePass model: used when page images are attached.
AUDIT_VISION_MODEL_ID=cline-pass/qwen3.7-plus

# Optional local Tesseract language data (eng/hin/mar .traineddata files), so a
# demo needs no network. Decompressed files, not the .gz the CDN serves.
AUDIT_TESSDATA_DIR=

# Where tesseract.js may cache downloaded language data (default: the OS temp
# directory, never the working directory).
AUDIT_TESSDATA_CACHE_DIR=

# Service limits (defaults shown).
AUDIT_HOST=127.0.0.1
AUDIT_PORT=8787

# Optional: when both are set, the masked result is stored (R14). Unset, the
# audit still returns its result and stores nothing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
