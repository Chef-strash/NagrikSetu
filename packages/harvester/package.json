    "@supabase/supabase-js": "^2.117.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "bin": {
    "nagriksetu-harvest": "dist/cli.js"
  }
