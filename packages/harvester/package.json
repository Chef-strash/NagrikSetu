{
  "name": "@nagriksetu/harvester",
  "version": "0.1.0",
  "private": true,
  "description": "NagrikSetu harvester: official-source PMC scheme profiler (Cline SDK).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
