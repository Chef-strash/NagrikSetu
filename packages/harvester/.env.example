# Harvester env (copy to .env; never commit real values — secrets via env only).
# Supabase project keys are REQUIRED for the live acceptance run (service role).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Models run on CLINE'S OWN models (ClinePass). No Anthropic key is needed.
# Auth = CLINE_API_KEY, or the Cline OAuth token in ~/.cline/data/settings/providers.json.
CLINE_API_KEY=
# Optional overrides (defaults shown).
HARVESTER_PROVIDER_ID=cline-pass
HARVESTER_MODEL_ID=cline-pass/glm-5.3
# Vision model used when scanned / legacy-font pages are attached as images.
HARVESTER_VISION_MODEL_ID=cline-pass/qwen3.7-plus
# live (default: fetch real documents) | fixture (offline captures, no network).
SCRAPER_MODE=live
