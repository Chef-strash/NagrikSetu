# @nagriksetu/agents env (copy to .env; never commit real values — secrets via env only).
#
# Auth order, first hit wins:
#   1. <PREFIX>_API_KEY  — HARVESTER_API_KEY for the harvester, AUDIT_API_KEY for the audit
#   2. CLINE_API_KEY, then the Cline OAuth token in
#      <CLINE_DATA_DIR>/settings/providers.json (~/.cline/data by default)
#   3. ANTHROPIC_API_KEY (anthropic) / <PROVIDER>_API_KEY (anything else)
# ClinePass models need only a Cline token — no Anthropic key required.
CLINE_API_KEY=

# Model overrides for the harvester (defaults shown).
HARVESTER_PROVIDER_ID=cline-pass
HARVESTER_MODEL_ID=cline-pass/glm-5.3
# Vision model, used automatically whenever page images ride the turn.
HARVESTER_VISION_MODEL_ID=cline-pass/qwen3.7-plus

# Model overrides for the citizen document audit.
AUDIT_API_KEY=
AUDIT_PROVIDER_ID=cline-pass
AUDIT_MODEL_ID=cline-pass/glm-5.3
AUDIT_VISION_MODEL_ID=cline-pass/qwen3.7-plus

# Harness data dir. @nagriksetu/agents overrides this per run with a volatile
# os.tmpdir() directory that is deleted afterwards (KTD1a) — set it only to
# point the SDK's *default* store somewhere else.
# CLINE_DATA_DIR=
