# NagrikSetu - environment template.
#
# ---------------------------------------------------------------------------
# YOU DO NOT NEED THIS FILE.
#
# With no .env present, the stack runs completely offline: the web app serves
# bundled fixtures and the backend answers from fixtures using deterministic
# (non-LLM) logic. Copy this file to .env only to enable a real database or a
# live model.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. DATABASE (optional)
# ===========================================================================
# Leave NAGRIKSETU_DISABLE_DB=1 to use the bundled fixtures. Set it to 0 and fill
# in a Supabase project to read live scheme data.
#
# Any Supabase project works, including a free one you create yourself.
# To populate your own project, run in order:
#   docs/SUPABASE_SETUP.sql
#   docs/migrations/001_tighten_rls.sql
#   docs/migrations/002_schema_v2.sql
#   docs/migrations/003_feedback_system.sql
#   docs/seed.sql                 <- the scheme/FAQ/review data snapshot
# See README.md, "Using your own Supabase project".

NAGRIKSETU_DISABLE_DB=1

# Project URL and public anon key. The anon key is safe to expose: every read is
# enforced by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Grants trusted writes (e.g. submitting a review) and bypasses
# RLS. NEVER expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=


# ===========================================================================
# 2. LANGUAGE MODEL (optional)
# ===========================================================================
# Leave NAGRIKSETU_DISABLE_LLM=1 for deterministic, non-LLM behaviour. The app is
# fully functional without a model; the answers are simply extractive rather
# than generated.

NAGRIKSETU_DISABLE_LLM=1

# --- Option A: Cline (no separate provider key) ----------------------------
# The Cline SDK normally reads the OAuth token left behind when you sign in to
# Cline on the machine (~/.cline/data/settings/providers.json). That file will
# NOT exist on a fresh checkout or inside a container, so supply a key here
# instead and the SDK authenticates from the environment.
#
# Get a key from your Cline account. Then:
#   LLM_PROVIDER=cline
#   CLINE_PROVIDER_ID=cline-pass
#   CLINE_MODEL_ID=cline-pass/deepseek-v4.1-flash
#   CLINE_API_KEY=<your key>
#
# If the key is missing or rejected the service logs the failure and falls back
# to the deterministic paths - it does not crash.

LLM_PROVIDER=
CLINE_PROVIDER_ID=
CLINE_MODEL_ID=
CLINE_API_KEY=

# --- Option B: a provider API key -----------------------------------------
# Used when the Cline route above is not enabled.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# For any OpenAI-compatible endpoint (Groq, Together, OpenRouter, Sarvam ...):
OPENAI_BASE_URL=
OPENAI_MODEL=


# ===========================================================================
# 3. SERVICE WIRING
# ===========================================================================
# Port the backend listens on.
PORT=8000

# Where the Next.js server-side proxy looks for the backend.
# Inside docker compose this is http://backend:8000 (the default).
# Running both directly on the host, leave it as http://localhost:8000.
NAGRIKSETU_API_URL=http://localhost:8000


# ===========================================================================
# 4. INGESTION (optional; not needed to run the app)
# ===========================================================================
# Used only by packages/harvester, the Cline-SDK agent that fills the database
# from official municipal documents. Leave unset unless you are running it.
#
# SCRAPER_MODE=live
# HARVESTER_PROVIDER_ID=cline-pass
# HARVESTER_MODEL_ID=cline-pass/glm-5.3
# HARVESTER_VISION_MODEL_ID=cline-pass/qwen3.7-plus


# ===========================================================================
# 3. WEB / AUDIT / VOICE (optional, used by docker compose)
# ===========================================================================
# Without docker compose, web variables go in packages/web/.env.local
# (template: packages/web/.env.example). Compose reads them from this file.

# Offline demo sign-in. Only effective while NEXT_PUBLIC_SUPABASE_URL is empty.
# Build-time for the web image: re-run `docker compose up --build` after changing.
NEXT_PUBLIC_DEMO_AUTH=true
NEXT_PUBLIC_DEMO_AUDIT=false
NEXT_PUBLIC_SUPPORT_EMAIL=

# Skip the sign-in screen entirely (demo / evaluation builds): land straight on the
# dashboard as the demo citizen (Ramesh Patil, Kothrud ward). It grants a LOCAL
# identity, not a Supabase session, so live reads still work through the anon key,
# but posting a review and server-side session sync still need a real sign-in.
# Build-time for the web image: re-run `docker compose up --build` after changing.
NEXT_PUBLIC_AUTO_LOGIN=false

# Voice (Sarvam). Empty = /api/v1/voice/* answers {"error":"not_configured"}.
SARVAM_API_KEY= 

# Document audit service. The token is shared by web and audit; compose supplies a
# local default, so you only need to set it to change it.
AUDIT_SERVICE_TOKEN=
AUDIT_API_KEY=
# true = download OCR language data when building the audit image (offline later).
BAKE_TESSDATA=false

REVIEWS_AUTO_PUBLISH=true
DOCUMENT_STORAGE_ENABLED=false
