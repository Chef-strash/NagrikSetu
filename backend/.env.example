# NagrikSetu backend - environment
# The service also reads the repository-root .env, so if that already defines the
# Supabase project you can leave this file out entirely.
#
# Next.js / Supabase key names are used directly so the same project is shared
# with the web app without duplicating secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key. Used for trusted writes / privileged reads (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to 1 to force the offline fixture path (no database reads).
NAGRIKSETU_DISABLE_DB=0

# HTTP port for the API server (default 8000).
PORT=8000

# --- LLM (query decomposition + FAQ answering) --------------------------------
# RECOMMENDED: route through the Cline SDK (uses your signed-in Cline account, so
# NO provider API key is needed). Requires @cline/sdk (installed) and a FRESH Cline
# auth — the SDK reads ~/.cline/data/settings/providers.json.
# LLM_PROVIDER=cline
# CLINE_PROVIDER_ID=cline                 # or "cline-pass"
# CLINE_MODEL_ID=cline-pass/deepseek-v4.1-flash

# Alternative: a provider API key (used when the Cline route is not enabled).
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# For any OpenAI-compatible endpoint (Groq / Together / OpenRouter / Sarvam):
# OPENAI_BASE_URL=https://api.openai.com/v1

# Tests / offline demos: force the deterministic decomposer + extractive answers.
# NAGRIKSETU_DISABLE_LLM=1

# --- Web search tool (OPTIONAL; off by default) --------------------------------
# The answering LLM may call a `web_search` tool. It is DISABLED unless one of
# these keys is set. Scheme facts must still come from official sources, so the
# model is told never to use web results for amounts/deadlines/eligibility.
# SERPER_API_KEY=...
# TAVILY_API_KEY=tvly-...
# BRAVE_API_KEY=...