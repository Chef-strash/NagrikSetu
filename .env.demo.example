# Copy to .env.demo and fill in. .env.demo is gitignored. Then: npm run demo:setup
# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Settings -> Database). Optional: enables schema setup/verify.
DATABASE_URL=
# Sarvam voice (STT/TTS)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
# Cline account key (backend LLM + audit service)
CLINE_API_KEY=
# Shared secret between web and audit service. Leave blank to auto-generate.
AUDIT_SERVICE_TOKEN=
# Models (defaults shown)
CLINE_MODEL_ID=cline-pass/glm-5.3
CLINE_VISION_MODEL_ID=cline-pass/qwen3.7-plus
